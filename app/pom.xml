<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/> <!-- lookup parent from repository -->
  </parent>

  <groupId>com.mystegui</groupId>
  <artifactId>budget-tracker</artifactId>
  <version>4.0.0-SNAPSHOT</version>
  <name>Student Budget Tracker (JDK 25 / Spring Boot 4 / OpenJFX 25)</name>
  <description>Rebuilt desktop app core — see requirements.md and design.md at the repository root.</description>

  <properties>
    <java.version>25</java.version>
    <openjfx.version>25.0.5</openjfx.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <mainClass>com.mystegui.budgettracker.BudgetTrackerApp</mainClass>
  </properties>

  <dependencies>
    <!-- Application core: Spring Boot dependency injection + events, NO web stack (design.md §2) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- Presentation: OpenJFX 25 (controls + fxml at the coherent LTS line) -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${openjfx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${openjfx.version}</version>
    </dependency>

    <!-- Tests: Boot test tooling (JUnit 5, AssertJ); persistence tests later use real temp SQLite files (design.md §4) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- javafx:run launches BudgetTrackerApp with correct platform modules (no classifier juggling) -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${mainClass}</mainClass>
        </configuration>
      </plugin>

      <!-- repackaging stays OFF for now: jpackage build (T13) uses the design.md §8
           classpath + module-path shape, not a Boot fat jar -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
